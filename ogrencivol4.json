        ".validate": "newData.hasChildren(['username', 'to_class_id', 'to_class_name', 'requested_at']) && newData.child('username').val() === root.child('users').child($uid).child('username').val()",
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "from_class_id": {
          ".validate": "newData.isNumber()"
        },
        "to_class_id": {
