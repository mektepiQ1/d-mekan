{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "usernames": {
      "$key": {
        ".read": true,
        ".write": "root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['email', 'uid']) && newData.child('email').isString() && newData.child('uid').isString()"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && data.exists() && newData.exists() && !data.child('exam').exists() && newData.child('exam').exists() && newData.child('education_status').exists() && newData.child('class_id').exists() && newData.child('username').val() === data.child('username').val() && newData.child('id').val() === data.child('id').val() && newData.child('created_at').val() === data.child('created_at').val()",
        ".validate": "newData.hasChildren(['id', 'username'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "_fbKey": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "exam": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "education_status": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "class_id": {
          ".validate": "newData.isNumber()"
        },
        "created_at": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "classes": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).exists())",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "lessons": {
      ".indexOn": [
        "class_id"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('class_id').exists() && query.orderByChild === 'class_id' && query.equalTo === root.child('users').child(auth.uid).child('class_id').val()))",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "exams": {
      ".indexOn": [
        "class_id"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('class_id').exists() && query.orderByChild === 'class_id' && query.equalTo === root.child('users').child(auth.uid).child('class_id').val()))",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "topics": {
      ".indexOn": [
        "class_id"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('users').child(auth.uid).child('class_id').exists() && query.orderByChild === 'class_id' && query.equalTo === root.child('users').child(auth.uid).child('class_id').val()))",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "options": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child(auth.uid).exists())",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "links": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "devices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$slot": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "($slot === 's1' || $slot === 's2') && newData.hasChildren(['id', 'created_at', 'last_seen'])",
          "id": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{32}$/)"
          },
          "created_at": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "last_seen": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "label": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "keys": {
      "$uid": {
        "$did": {
          ".read": "auth != null && auth.uid === $uid && (root.child('devices').child($uid).child('s1').child('id').val() === $did || root.child('devices').child($uid).child('s2').child('id').val() === $did)",
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || (!data.exists() && (root.child('devices').child($uid).child('s1').child('id').val() === $did || root.child('devices').child($uid).child('s2').child('id').val() === $did)))) || (root.child('admins').child(auth.uid).val() === true && !newData.exists()))",
          ".validate": "newData.isString() && newData.val().length === 44"
        }
      }
    },
    "classRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
